# Application
APP_ENV=development
APP_NAME=Fall Risk Platform
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

# Authentication - replace every value before deployment
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# MySQL
MYSQL_DATABASE=fall_risk
MYSQL_USER=fall_user
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
DATABASE_URL=mysql+asyncmy://fall_user:replace-with-a-database-password@mysql:3306/fall_risk

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=fall-risk-admin
MINIO_SECRET_KEY=replace-with-a-minio-password
MINIO_SECURE=false
MINIO_BUCKET_EVENTS=fall-events
HEALTH_CHECK_TIMEOUT_SECONDS=2

# EZVIZ credentials are intentionally server-side only.
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
EZVIZ_API_BASE_URL=https://open.ys7.com
EZVIZ_REQUEST_TIMEOUT_SECONDS=10
EZVIZ_TOKEN_REFRESH_SKEW_SECONDS=600
EZVIZ_TOKEN_LOCK_TIMEOUT_SECONDS=15
EZVIZ_DEVICE_SYNC_PAGE_SIZE=50
EZVIZ_PACKAGE_CODE_01=
EZVIZ_PACKAGE_CODE_02=
EZVIZ_PACKAGE_CODE_03=
EZVIZ_PACKAGE_CODE_04=
EZVIZ_PACKAGE_CODE_05=
EZVIZ_COUPON_REDEEMED=false

# Offline dataset playback. Dataset videos stay outside Git.
OFFLINE_VIDEO_ROOT=/data/offline-videos
OFFLINE_VIDEO_CACHE_ROOT=/data/offline-video-cache
OFFLINE_PLAYBACK_TICKET_EXPIRE_SECONDS=1800
OFFLINE_VIDEO_TRANSCODE_TIMEOUT_SECONDS=300

# Feature flags: paid cloud capabilities remain off by default.
FEATURE_CLOUD_RECORDING=false
FEATURE_EZVIZ_MESSAGE_PUSH=false
FEATURE_EZVIZ_CLOUD_AI=false
FEATURE_LOCAL_EVENT_RECORDING=true
FEATURE_LOCAL_AI_INFERENCE=true
