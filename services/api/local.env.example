# Phase 1 native Windows mode (no Docker)
APP_ENV=development
APP_NAME=Fall Risk Platform
LOG_LEVEL=INFO

# Replace both values before the first run. Do not commit services/api/.env.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123
COOKIE_SECURE=false

# The path is resolved from services/api when using scripts/start-local-api.ps1.
DATABASE_URL=sqlite+aiosqlite:///../../data/local/fall_risk.db
AUTO_CREATE_TABLES=false
LOCAL_LIGHTWEIGHT_MODE=true

# Kept for later full mode; lightweight mode does not connect to these services.
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false
HEALTH_CHECK_TIMEOUT_SECONDS=2

# Phase 2 EZVIZ Open Platform. Keep these values server-side and out of Git.
EZVIZ_API_BASE_URL=https://open.ys7.com
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
EZVIZ_REQUEST_TIMEOUT_SECONDS=10
EZVIZ_TOKEN_REFRESH_SKEW_SECONDS=600
EZVIZ_TOKEN_LOCK_TIMEOUT_SECONDS=15
EZVIZ_DEVICE_SYNC_PAGE_SIZE=50

# Phase 3 package codes. Configure only when a real device is ready for activation.
EZVIZ_PACKAGE_CODE_01=
EZVIZ_PACKAGE_CODE_02=
EZVIZ_PACKAGE_CODE_03=
EZVIZ_PACKAGE_CODE_04=
EZVIZ_PACKAGE_CODE_05=
EZVIZ_COUPON_REDEEMED=false

# Phase 2A offline video simulation. The path is resolved from services/api.
OFFLINE_VIDEO_ROOT=../../data/offline-videos
OFFLINE_VIDEO_CACHE_ROOT=../../data/local/offline-video-cache
OFFLINE_PLAYBACK_TICKET_EXPIRE_SECONDS=1800
OFFLINE_VIDEO_TRANSCODE_TIMEOUT_SECONDS=300
